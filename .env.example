DB_DATABASE=booking_saas
DB_USERNAME=booking_admin
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Per-stack isolation (dev defaults shown). Production uses e.g.
# CONTAINER_PREFIX=booking-prod, WEB_PORT=8091, MAILPIT_PORT=8026
CONTAINER_PREFIX=booking
WEB_PORT=8090
MAILPIT_PORT=8025

# The PHP image remaps www-data to this UID/GID so containers and the host user own the same
# files. Defaults to 1000; set to the output of `id -u` / `id -g` if yours differ.
HOST_UID=1000
HOST_GID=1000
